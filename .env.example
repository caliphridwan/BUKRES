# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://buk:buk@localhost:5432/buk_results?schema=public"

# --- Security -------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL, used in statement QR codes and the CSRF origin check
APP_URL="http://localhost:3000"

# --- Branding (configurable until the Faculty authorises official use) -----
NEXT_PUBLIC_BRAND_NAME="Faculty of Computing Result Portal"
NEXT_PUBLIC_BRAND_INSTITUTION="Bayero University, Kano"
# Path under /public, e.g. /brand/logo.png. Empty = neutral monogram.
NEXT_PUBLIC_BRAND_LOGO=""
# "false" shows a 'Pilot — not an official university service' notice
NEXT_PUBLIC_OFFICIAL="false"

# --- Email (optional) -----------------------------------------------------
SMTP_URL=""
MAIL_FROM="results-portal@example.edu.ng"
